{
  "name": "endless-tic-tac-toe-multiplayer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Endless Tic-Tac-Toe, online multiplayer with room codes",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
